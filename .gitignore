# Directories to ignore
.claude/
.idea/
.venv/

# Configuration files to ignore
lseg-data.config.json

# Archive folder
archive/

# Serrano database files (large)
data/raw/serrano/

# Exclude all exe files and installers
*.exe
*.msi
*.dmg
desktop.ini

# Exclude Excel files (often large)
*.xlsx
*.xls

# Large data files
data/intermediate/finbas/finbas_monthly_clean.csv
data/intermediate/serrano/serrano_accounting.csv
data/processed/merged_data_monthly.csv
data/processed/ptree_dataset_monthly.csv
data/raw/finbas/raw_finbas_monthly.csv
data/raw/serrano/Stata_2025/*.dta
data/raw/macro/raw_macro_factors.csv

# Results files that may be large
results/inputs/ptree_inputs.rds

# Mapping files - automated is generated, manual is tracked
data/mappings/automated/
data/mappings/isin_orgnr_final.csv
